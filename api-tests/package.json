{
  "name": "task-tracker-api-tests",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "test": "playwright test --project=api-spec",
    "test:report": "playwright test --project=api-spec --reporter=html",
    "bdd:gen": "bddgen",
    "test:bdd": "npm run bdd:gen && playwright test --project=bdd",
    "test:all": "npm run bdd:gen && playwright test",
    "test:all:report": "npm run bdd:gen && playwright test --reporter=html"
  },
  "devDependencies": {
    "@playwright/test": "^1.46.0",
    "playwright-bdd": "^9.2.0"
  }
}
